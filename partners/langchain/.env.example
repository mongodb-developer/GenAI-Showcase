# Copy to .env in this folder and fill it in. Both sets here, advanced-rag/ and
# claude-code-mcp/, read it via python-dotenv, which finds the nearest .env at or above
# the notebook's folder. A missing value falls back to an interactive getpass prompt, so
# Colab works without a .env at all.

# --- MongoDB Atlas ---
# Your Atlas M0 (free tier) SRV connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sample_mflix
# Advanced RAG notebook 3 creates one scratch collection for its auto-embedding demo and
# drops it during cleanup. It refuses to reuse a collection that already exists, so set
# this only if the default name is already taken on your cluster.
LANGCHAIN_AUTO_EMBED_COLLECTION=auto_embed_demo

# --- Atlas-hosted embeddings + reranking (ai.mongodb.com) ---
# Atlas Admin API key used to call the hosted embedding and rerank endpoints.
MDB_ATLAS_API_KEY=
# sample_mflix.embedded_movies ships with voyage-3-large (2048-d) plot vectors,
# so query embeddings use the same model/dimensions to share the vector space.
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_DIMENSIONS=2048

# --- Claude (LLM) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional: point ChatAnthropic at an Anthropic-compatible gateway (e.g. Grove).
# Leave blank to use the default Anthropic API (api.anthropic.com).
# Give the ROOT url WITHOUT the trailing /v1/messages -- the SDK appends that
# itself, e.g. https://<gateway-host>/<path>/anthropic
ANTHROPIC_BASE_URL=
# Some gateways (e.g. Azure API Management fronting Grove) authenticate with an
# "api-key" header instead of Anthropic's default "x-api-key". When ANTHROPIC_BASE_URL
# is set, the notebooks send ANTHROPIC_API_KEY in the "api-key" header automatically.
