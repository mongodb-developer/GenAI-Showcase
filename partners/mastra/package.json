{
  "name": "mongodb-mastra-cookbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mastra + MongoDB Atlas notebook set for the MongoDB partner cookbooks",
  "scripts": {
    "test": "vitest run && tsx scripts/check-notebook-outputs.ts",
    "test:unit": "vitest run",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "check:outputs": "tsx scripts/check-notebook-outputs.ts",
    "postinstall": "node scripts/prefetch-tokenizer.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.79",
    "@huggingface/transformers": "3.8.1",
    "@mastra/core": "1.76.0",
    "@mastra/memory": "1.37.0",
    "@mastra/mongodb": "1.23.0",
    "@mastra/voyageai": "0.4.1",
    "mongodb": "7.7.0",
    "onnxruntime-node": "1.30.0",
    "tslib": "2.8.1",
    "voyageai": "0.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tslab": "1.0.22",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "sharp": "0.35.5",
    "adm-zip": "0.6.1"
  }
}
