# --- MongoDB (driver: deterministic monitor reads + demo seeding) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ambient_inventory_agent
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# --- MongoDB Remote MCP (every agent tool call goes through this) ---
MDB_MCP_API_BASE_URL=https://mcp-dev.mongodb.com
MDB_MCP_API_CLIENT_ID=
MDB_MCP_API_CLIENT_SECRET=
# Atlas project + cluster the MCP server connects to. Required: MCP data tools
# take a connectionId returned by remote-atlas-connect.
MDB_MCP_PROJECT_ID=
MDB_MCP_CLUSTER_NAME=Cluster0

# --- Bedrock (Anthropic models) ---
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
BEDROCK_MAX_TOKENS=8192
# Use a model with adaptive thinking (Claude 4.6 or later). Older ids reject the
# thinking/effort fields the sweep sends and fail on the first call.

# --- Demo pacing ---
# 0 = start the sweep as soon as the page loads, so the agent's MCP calls appear
# in the activity feed immediately and you can narrate over them.
DEMO_ALERT_DELAY_SECONDS=0
DEMO_SEED_ON_START=true
